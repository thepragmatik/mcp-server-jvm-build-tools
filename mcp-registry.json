{
  "name": "mcp-server-jvm-build-tools",
  "version": "2.0.0-rc.2",
  "description": "MCP server for Maven, Gradle, and SBT with guarded project access and redacted diagnostics.",
  "homepage": "https://github.com/thepragmatik/mcp-server-jvm-build-tools",
  "license": "Apache-2.0",
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false,
    "stdio": true,
    "streamableHttp": true
  },
  "transports": [
    {
      "type": "stdio"
    },
    {
      "type": "streamable-http",
      "endpoint": "/mcp",
      "requiresBearerToken": true
    }
  ],
  "tools": {
    "total": 24,
    "names": [
      "analyze_build_output",
      "analyze_build_performance",
      "analyze_pom_dependencies",
      "analyze_sbt_build",
      "check_dependency_version",
      "check_java_compatibility",
      "check_tool_authorization",
      "detect_build_tool",
      "detect_dependency_conflicts",
      "detect_sbt_modules",
      "detect_sbt_test_frameworks",
      "execute_build_command",
      "get_build_tool_version",
      "list_available_scopes",
      "list_build_resources",
      "list_build_tools",
      "list_dependency_resources",
      "profile_build",
      "prompt_build_and_test",
      "prompt_build_diagnosis",
      "prompt_dependency_audit",
      "scan_dependency_cves",
      "validate_build_configuration",
      "validate_ci_flow"
    ]
  }
}
